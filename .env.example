# Application Config
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
APP_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# Database (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/auth_db?schema=public

# JWT Configuration
JWT_ACCESS_SECRET=your_super_secret_access_token_key_change_in_production_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_super_secret_refresh_token_key_change_in_production_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# Password Reset Token
PASSWORD_RESET_TOKEN_EXPIRES_IN_MINUTES=15

# Security & Cookies
COOKIE_SECRET=your_super_cookie_secret_key_change_in_production
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=10

# Email Service (Nodemailer SMTP)
# Leave empty or set EMAIL_SERVICE=mock to log emails to console in development
EMAIL_SERVICE=mock
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Auth Service <noreply@yourdomain.com>"
